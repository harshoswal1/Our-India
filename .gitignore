# ===========================
# Our India — Root .gitignore
# ===========================

# ---- Android ----
android/.gradle/
android/build/
android/app/build/
android/ailawyer/build/
android/app/schemas/
android/local.properties
android/captures/
android/.cxx/
android/.externalNativeBuild/
*.iml

# ---- Secrets & Keys ----
local.properties
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.jks
*.keystore
# Shared debug key (standard "android" passwords, not a release key) so CI and every
# teammate's builds install over each other. Never put a release keystore here.
!android/debug.keystore
google-services.json

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- Logs & Python ----
*.log
__pycache__/
*.py[cod]
*$py.class
.kilo/agents/data.md
