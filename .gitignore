# ===========================
# Our India — Root .gitignore
# ===========================

# ---- Python / Backend ----
backend/.env
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.Python
backend/drop_table.py
backend/list_models.py
backend/test_vector.py
backend/*.egg-info/
backend/dist/
backend/build/
*.db
*.sqlite3

# ---- Node.js / Frontend ----
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/out/
frontend/build/

# ---- Environment & Secrets ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
